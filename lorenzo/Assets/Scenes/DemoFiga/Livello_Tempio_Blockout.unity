--- !u!1001 &914350822
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1474285825}
    m_Modifications:
    - target: {fileID: 6756634983376662360, guid: 29b5eab451744427aa3b6291a8003c8f, type: 3}
      propertyPath: card
      value: 
      objectReference: {fileID: 11400000, guid: 5d274a770c6c047d59d59a5448fea4d4, type: 2}
    - target: {fileID: 6756634983376662360, guid: 29b5eab451744427aa3b6291a8003c8f, type: 3}
      propertyPath: text
      value: "Per i Romani il tempio era la casa del dio: nella cella stava la sua
        statua.\n\nI riti per\xF2 si facevano fuori. L'altare era all'aperto, davanti
        alla scalinata, e l\xEC si portavano le offerte.\n\nPer questo qui l'altare
        \xE8 nel cortile, e la cella resta chiusa finch\xE9 il rito non \xE8 compiuto."
      objectReference: {fileID: 0}
    - target: {fileID: 6756634983376662360, guid: 29b5eab451744427aa3b6291a8003c8f, type: 3}
      propertyPath: title
      value: La casa del dio
      objectReference: {fileID: 0}
    - target: {fileID: 6756634983376662360, guid: 29b5eab451744427aa3b6291a8003c8f, type: 3}
      propertyPath: source
      value: '[fonte da verificare: Vitruvio, De architectura, libri III-IV]'
      objectReference: {fileID: 0}
