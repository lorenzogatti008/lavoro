  m_Script: {fileID: 11500000, guid: acc8882de7ea24c9788aa1662311398d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Heritage.Kit::InfoPoint
  title: Prima dell'alba
  text: "Manca poco all'alba. Nella notte il fuoco del tempio si \xE8 spento, e la
    processione sta gi\xE0 salendo dal Foro.\n\nSei il camillus, il ragazzo che assiste
    ai riti: tocca a te riaccenderlo.\n\nPorta un'offerta all'altare, accendi i tre
    fuochi del sacello, poi entra nella cella."
  image: {fileID: 0}
  source: 'Racconto di fantasia [da verificare]'
  objective: {fileID: 0}
  onClosed:
    m_PersistentCalls:
      m_Calls: []
